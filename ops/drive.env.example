# 复制为 /etc/simple-drive.env；替换密钥，勿将实际配置提交到版本库。
# 使用 python3.9 -c 'import secrets; print(secrets.token_hex(32))' 生成密钥。
DRIVE_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DRIVE_STATE_DIR=/var/lib/simple-drive
DRIVE_MAX_FILE_MB=1024
# HTTPS 设置为 1；仅 HTTP 的本机验证可设为 0。
DRIVE_COOKIE_SECURE=1
# 配套 Nginx + Gunicorn 仅监听 127.0.0.1 时启用；直接访问应用时设 0。
DRIVE_TRUST_PROXY=1
