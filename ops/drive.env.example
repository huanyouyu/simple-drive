# run.sh 首次运行自动生成 ops/drive.env 并替换密钥，后续复用。
# 修改配置后重新启动；实际配置已由 .gitignore 忽略。
DRIVE_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DRIVE_STATE_DIR=instance
DRIVE_MAX_FILE_MB=1024
# 默认可通过服务器 IP 访问；使用 Nginx 时改为 127.0.0.1:8000。
DRIVE_BIND=0.0.0.0:8000
# 默认直接使用 HTTP；配置 HTTPS 后设置为 1。
DRIVE_COOKIE_SECURE=0
# 配套 Nginx + Gunicorn 仅监听 127.0.0.1 时启用；直接访问应用时设 0。
DRIVE_TRUST_PROXY=0
